# 🏛️ PRAMAAN AI (प्रमाण AI) — PRODUCTION ENVIRONMENT CONFIGURATION
# ═════════════════════════════════════════════════════════════════════

# 1. PostgreSQL Database Configuration (Self-hosted or Cloud Neon/Supabase)
POSTGRES_USER=pramaan_admin
POSTGRES_PASSWORD=pramaan_secure_pass_2026
POSTGRES_DB=pramaan_db
POSTGRES_PORT=5432

# For local docker-compose:
# DATABASE_URL=postgresql://pramaan_admin:pramaan_secure_pass_2026@postgres:5432/pramaan_db
# For Cloud Neon / Supabase:
# DATABASE_URL=postgresql://user:pass@ep-cool-neon.us-east-2.aws.neon.tech/neondb?sslmode=require

# 2. Backend API Service Configuration
APP_NAME="Pramaan AI"
APP_ENV=production
BACKEND_PORT=8000
JWT_SECRET_KEY=replace_with_64_character_cryptographic_random_string_in_production

# Optional: Google Gemini API Key for autonomous LLM viva questions
GEMINI_API_KEY=AIzaSy...

# Optional: GitHub Personal Access Token (5,000 req/hr rate limit & PR bot commenting)
GITHUB_TOKEN=ghp_...

# 3. Frontend Web Client Configuration
FRONTEND_PORT=3000
PRODUCTION_FRONTEND_URL=https://pramaan.ai
NEXT_PUBLIC_API_URL=https://api.pramaan.ai

# 4. Evaluator Webhook & Notification Integration (Optional)
DEFAULT_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
DEFAULT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
