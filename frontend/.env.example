# Pramaan AI — Production Frontend Environment Variables (Vercel / Local)
NEXT_PUBLIC_APP_URL="https://pramaan-ai-frontend-lovat.vercel.app"
NEXT_PUBLIC_API_URL="http://localhost:8000"

# GitHub OAuth Application (Registered at https://github.com/settings/developers)
# Expected Callback URL: https://pramaan-ai-frontend-lovat.vercel.app/api/auth/github/callback
# Local Dev Callback: http://localhost:3000/api/auth/github/callback
GITHUB_CLIENT_ID="your_github_oauth_client_id"
GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"

# Cryptographic Session Secret (At least 32 characters, e.g. openssl rand -hex 32)
AUTH_SECRET="your_32_character_cryptographic_auth_secret_here"

# Neon Serverless PostgreSQL Connection String
DATABASE_URL="postgresql://user:password@ep-host.region.neon.tech/neondb?sslmode=require"
# POSTGRES_URL is also automatically recognized if provisioned via Vercel Neon Integration
# POSTGRES_URL="postgresql://user:password@ep-host.region.neon.tech/neondb?sslmode=require"

# Google Gemini API Key for Server-Side Viva Defense Question Generation & Scoring
GEMINI_API_KEY="AIzaSy..."

# GitHub Personal Access Token (for server-side GitHub API rate limits - 5000 req/hr)
GITHUB_TOKEN="ghp_..."
