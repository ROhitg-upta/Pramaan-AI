# Pramaan AI — Production Backend Environment Variables
APP_NAME="Pramaan AI Enterprise"
APP_ENV="production"
APP_DEBUG=false
APP_PORT=8000
APP_HOST="0.0.0.0"

# Real Cloud PostgreSQL (Neon / Supabase / AWS RDS / Railway)
# Example: postgresql://neondb_owner:secret@ep-cool-neon.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://neondb_owner:secret@ep-cool-neon.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Gemini Autonomous Oral Defense Engine
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL_QUESTION="gemini-2.5-flash"
GEMINI_MODEL_EVALUATE="gemini-2.5-flash"
GEMINI_MODEL_SUMMARY="gemini-2.5-flash"

# Repository Processing Cache
REPO_CLONE_DIR="./tmp/repos"
REPO_MAX_COMMITS=1000

# CORS Whitelist
CORS_ORIGINS=["http://localhost:3000","https://pramaan.ai"]
