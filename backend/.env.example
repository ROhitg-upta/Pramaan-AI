# App Config
APP_NAME=Pramaan AI
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
APP_HOST=0.0.0.0

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL_QUESTION=gemini-2.5-flash
GEMINI_MODEL_EVALUATE=gemini-2.5-flash
GEMINI_MODEL_SUMMARY=gemini-2.5-flash
GEMINI_TEMPERATURE_QUESTION=0.4
GEMINI_TEMPERATURE_EVALUATE=0.2

# Database
DATABASE_URL=sqlite:///./pramaan.db

# Repository Processing Limits
REPO_CLONE_DIR=./tmp/repos
REPO_MAX_COMMITS=1000
REPO_MAX_FILE_SIZE_KB=500
REPO_CLONE_TIMEOUT_SECONDS=60

# Anomaly Thresholds
BIG_BANG_THRESHOLD_LINES=1500
BIG_BANG_THRESHOLD_COMMITS=3
GHOST_CONTRIBUTOR_DOC_RATIO=0.80
PANIC_BURST_WINDOW_HOURS=8

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
